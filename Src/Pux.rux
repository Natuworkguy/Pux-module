module Pux {
    import Std::String;

    @[Import(lib: "pygame_bindings.dll")]
    extern {
        /// Initializes the graphics system with the specified width and height.
        /// Parameters:
        /// - `width`: The width of the window in pixels.
        /// - `height`: The height of the window in pixels.
        func pg_init(
            width: int,
            height: int
        );

        /// Clears the screen.
        /// Parameters:
        /// - `color`: The color to clear the screen with.
        func pg_clear();

        /// Presents the rendered frame.
        func pg_present();

        /// Draws a rectangle on the screen.
        /// Parameters:
        /// - `x`: The x-coordinate of the top-left corner of the rectangle.
        /// - `y`: The y-coordinate of the top-left corner of the rectangle.
        /// - `w`: The width of the rectangle.
        /// - `h`: The height of the rectangle.
        /// - `r`: The red component of the rectangle's color.
        /// - `g`: The green component of the rectangle's color.
        /// - `b`: The blue component of the rectangle's color.
        func pg_draw_rect(
            x: int,
            y: int,
            w: int,
            h: int,
            r: int,
            g: int,
            b: int
        );

        /// Checks if the graphics system is running.
        /// Returns:
        /// - `1`: If the system is running.
        /// - `0`: If the system is not running.
        func pg_running() -> int;

        /// Quits the graphics system.
        func pg_quit();
    }
}