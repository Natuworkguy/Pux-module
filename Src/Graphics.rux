module Pux {
    @[Import(lib: "pygame_bindings.dll")]
    extern {
        /// Clears the screen.
        /// Parameters:
        /// - `color`: The color to clear the screen with.
        func pg_clear(color: int);

        /// Presents the rendered frame.
        func pg_present();

        /// Draws a rectangle on the screen.
        /// Parameters:
        /// - `x`: The x-coordinate of the top-left corner of the rectangle.
        /// - `y`: The y-coordinate of the top-left corner of the rectangle.
        /// - `w`: The width of the rectangle.
        /// - `h`: The height of the rectangle.
        /// - `r`: The red component of the rectangle's color.
        /// - `g`: The green component of the rectangle's color.
        /// - `b`: The blue component of the rectangle's color.
        func pg_draw_rect(
            x: int,
            y: int,
            w: int,
            h: int,
            r: int,
            g: int,
            b: int
        );
    }
}